-- A1 -- ANCLA DURA
-- Un proceso que no es el navegador abre una de las tres bases de datos del
-- perfil: Login Data (contrasenas), Web Data (tarjetas y autorrelleno) o
-- Cookies (sesiones).
--
-- Fuente requerida: Custom.TFM.Control.Streaming / S1_Read_4663 (Security 4663)
-- Sustituir el client_id por el del despliegue propio.

LET credential_dbs = '''Login Data|Web Data|Cookies'''

SELECT Timestamp,
       ProcessName,   -- ruta completa del proceso lector
       ObjectName,    -- fichero al que accede
       AccessMask
FROM source(client_id='C.XXXXXXXXXXXXXXXX',
            artifact='Custom.TFM.Control.Streaming/S1_Read_4663')
WHERE ObjectName =~ credential_dbs
  -- Declarativo: Local State no puede casar con el patron anterior. Se mantiene
  -- para dejar constancia de que queda fuera del ancla dura y se trata en A2.
  AND NOT ObjectName =~ 'Local State'
  -- Reduccion de falsos positivos: por binario nombrado, no por directorio.
  AND NOT ProcessName =~ '''\\Windows\\explorer\.exe$|\\System32\\dllhost\.exe$|\\SearchIndexer\.exe$'''
